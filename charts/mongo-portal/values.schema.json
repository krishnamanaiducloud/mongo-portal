{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "platform", "config"],
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "variant": { "enum": ["production", "debug"] },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "platform": { "enum": ["openshift", "kubernetes"] },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "config": {
      "type": "object",
      "required": ["profiles"],
      "properties": {
        "profiles": { "type": "array", "minItems": 1 }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string", "minLength": 1 },
        "serviceCA": { "type": "boolean" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "egress": {
          "type": "object",
          "properties": {
            "mongodb": {
              "type": "array",
              "items": { "type": "object", "required": ["to"] }
            }
          }
        }
      }
    }
  }
}
