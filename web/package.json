{
  "name": "mongo-portal-web",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.sandbox.config.ts --mode bootstrap && vite build --config vite.sandbox.config.ts --mode worker",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mongosh/browser-runtime-core": "5.11.7",
    "@mongosh/types": "5.4.0",
    "@patternfly/patternfly": "^6.7.0",
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-icons": "^6.7.0",
    "@patternfly/react-table": "^6.7.0",
    "@tanstack/react-query": "^5.107.1",
    "assert": "2.1.0",
    "bson": "7.3.4",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "path-browserify": "1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "util": "0.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "basic-ftp": "6.2.2",
    "body-parser": "2.4.0",
    "zod": "^4.6.6"
  }
}
